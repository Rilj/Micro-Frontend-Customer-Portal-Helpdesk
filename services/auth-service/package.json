{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication & User Management Service",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependabot": {
    "allow": [
      {
        "dependency-type": "direct"
      }
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.2",
    "@nestjs/config": "^3.2",
    "@nestjs/core": "^10.2",
    "@nestjs/jwt": "^10.2",
    "@nestjs/passport": "^10.0",
    "@nestjs/platform-express": "^10.2",
    "@nestjs/swagger": "^8.0.0",
    "bcryptjs": "^2.4",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "passport": "^0.6",
    "passport-jwt": "^4.0",
    "passport-local": "^1.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "helmet": "^8.0"
  },
   "devDependencies": {
    "@nestjs/cli": "^10.2",
    "@types/bcryptjs": "^2.4",
    "@types/express": "^4.17",
    "@types/jest": "^29.5",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@types/passport-jwt": "^3.0",
    "@types/passport-local": "^1.0",
    "eslint": "^9",
    "jest": "^29.7",
    "ts-jest": "^29.1",
    "ts-loader": "^9.5",
    "ts-node": "^10.9",
    "typescript": "^5.6"
  }
}
