{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "Real-time chat service with WebSocket",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "cors": "^2.8",
    "dotenv": "^16.4",
    "express": "^4.19",
    "jsonwebtoken": "^9.0",
    "socket.io": "^4.8",
    "redis": "^4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8",
    "@types/express": "^4.17",
    "@types/jsonwebtoken": "^9.0",
    "@types/node": "^22",
    "ts-node-dev": "^2.0",
    "typescript": "^5.6",
    "eslint": "^9",
    "jest": "^29.7",
    "@types/jest": "^29.5",
    "ts-jest": "^29.1",
    "supertest": "^7.1"
  }
}
