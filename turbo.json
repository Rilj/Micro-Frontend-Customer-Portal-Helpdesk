{
  "$schema": "https://turbo.build/repo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "src/**/*.go", "*.test.ts"]
    },
    "lint": {},
    "typecheck": {},
    "clean": {},
    "deploy": {
      "dependsOn": ["build", "test"]
    },
    "dev": {
      "cache": false
    }
  }
}
